<resources>
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorAccent">#FFCC00</item>
        <item name="colorPrimary">#222222</item>
        <item name="colorPrimaryDark">#222222</item>
        <item name="android:windowBackground">#333333</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:statusBarColor">#333333</item>
        <item name="android:navigationBarColor">#222222</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorHint">#8A8A8A</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="alertDialogTheme">@style/AppDialog</item>
    </style>
    <style name="AppDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="colorAccent">#FFCC00</item>
    </style>
</resources>
